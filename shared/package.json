{
  "name": "@opencode-manager/shared",
  "version": "1.2.0",
  "description": "Shared schemas, types, OpenCode helpers and Manager API contracts for OpenCode Manager clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chriswritescode-dev/opencode-manager.git",
    "directory": "shared"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./types": "./src/types/index.ts",
    "./types/errors": "./src/types/errors.ts",
    "./config": "./src/config/index.ts",
    "./config/defaults": "./src/config/defaults.ts",
    "./config/env": "./src/config/env.ts",
    "./config/client": "./src/config/client.ts",
    "./utils": "./src/utils/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./project-id": "./src/project-id-resolver.ts",
    "./opencode": "./src/opencode/index.ts",
    "./opencode/config-validation": "./src/opencode/config-validation.ts",
    "./themes": "./src/themes/index.ts"
  },
  "dependencies": {
    "@opencode/client": "catalog:",
    "@opencode/schema": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.1.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
